use super::hash::{Hasher, hash_step}
use std::evm::ops

/// Compute an SMT root with proof compression (siblings omitted when default).
///
/// - `DEPTH` is the fixed tree depth.
/// - `index` bits are read from least-significant upwards (level 0 = LSB).
/// - `enables` bit `i` indicates whether a sibling is supplied for level `i`.
/// - `siblings` is a packed list of the enabled siblings, in increasing level order.
///
/// Empty node defaults are derived from `zero[0] = 0` and `zero[i+1] = hash(zero[i], zero[i])`.
pub fn compute_root<H: Hasher, const DEPTH: usize>(
    leaf: u256,
    index: u256,
    enables: u256,
    siblings: [u256; DEPTH],
) -> u256 {
    let scratch = H::alloc_scratch()
    let mut node = leaf
    let mut idx = index

    let all_enabled_mask = (1 << (DEPTH as u256)) - 1
    let needs_zeros = enables != all_enabled_mask

    let mut en = enables
    let mut zero: u256 = 0
    let mut sibling_cursor: usize = 0

    let mut i: usize = 0
    while i < DEPTH {
        let sibling = if needs_zeros {
            let enabled = (en & 1) == 1
            en = en >> 1
            if enabled {
                let s = siblings[sibling_cursor]
                sibling_cursor = sibling_cursor + 1
                s
            } else {
                zero
            }
        } else {
            siblings[i]
        }

        node = hash_step<H>(scratch, node, sibling, (idx & 1) == 1)
        idx = idx >> 1

        if needs_zeros {
            zero = H::hash2_at(scratch, zero, zero)
        }

        i = i + 1
    }

    node
}

pub fn verify_membership<H: Hasher, const DEPTH: usize>(
    root: u256,
    leaf: u256,
    index: u256,
    enables: u256,
    siblings: [u256; DEPTH],
) -> bool {
    compute_root<H, DEPTH>(leaf, index, enables, siblings) == root
}

pub fn update_root<H: Hasher, const DEPTH: usize>(
    current_root: u256,
    old_leaf: u256,
    new_leaf: u256,
    index: u256,
    enables: u256,
    siblings: [u256; DEPTH],
) -> u256 {
    let old_root = compute_root<H, DEPTH>(old_leaf, index, enables, siblings)
    if old_root != current_root {
        ops::revert(0, 0)
    }
    compute_root<H, DEPTH>(new_leaf, index, enables, siblings)
}
