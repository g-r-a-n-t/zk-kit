use super::hash::{Hasher, hash_step}
use std::evm::ops

pub fn compute_root_from_proof<H: Hasher, const MAX_SIBLINGS: usize>(
    leaf: u256,
    index: u256,
    siblings_len: u256,
    siblings: [u256; MAX_SIBLINGS],
) -> u256 {
    if siblings_len > (MAX_SIBLINGS as u256) {
        ops::revert(0, 0)
    }

    let scratch = H::alloc_scratch()
    let mut node = leaf
    let mut idx = index
    let siblings_len_usize: usize = siblings_len as usize

    let mut i: usize = 0
    while i < siblings_len_usize {
        node = hash_step<H>(scratch, node, siblings[i], (idx & 1) == 1)
        idx = idx >> 1
        i = i + 1
    }

    node
}

pub fn verify_proof<H: Hasher, const MAX_SIBLINGS: usize>(
    root: u256,
    leaf: u256,
    index: u256,
    siblings_len: u256,
    siblings: [u256; MAX_SIBLINGS],
) -> bool {
    compute_root_from_proof<H, MAX_SIBLINGS>(leaf, index, siblings_len, siblings) == root
}

pub fn update_root_from_proof<H: Hasher, const MAX_SIBLINGS: usize>(
    current_root: u256,
    old_leaf: u256,
    new_leaf: u256,
    index: u256,
    siblings_len: u256,
    siblings: [u256; MAX_SIBLINGS],
) -> u256 {
    let old_root = compute_root_from_proof<H, MAX_SIBLINGS>(old_leaf, index, siblings_len, siblings)
    if old_root != current_root {
        ops::revert(0, 0)
    }
    compute_root_from_proof<H, MAX_SIBLINGS>(new_leaf, index, siblings_len, siblings)
}
